LM_MODEL="qwen/qwen3-4b-2507"

# GitHub OAuth App credentials, used by the Electron "Sign in with GitHub" flow.
# Register an OAuth App at https://github.com/settings/developers with callback
# URL commshelper://oauth/callback. The client secret is only ever read by the
# local FastAPI server (backend/src/communications_helper_agent/api/server.py)
# and must never be shipped to the Electron/renderer code.
GITHUB_OAUTH_CLIENT_ID=your_oauth_app_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_app_client_secret_here

# Optional fallback used only by the standalone example_mcp.py script for
# direct CLI testing without going through the OAuth flow. The Electron app
# exclusively uses the OAuth-derived token.
GITHUB_PERSONAL_ACCESS_TOKEN=